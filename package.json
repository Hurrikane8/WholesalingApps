{
  "name": "wholesaling-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "cross-env SITE_ENV=preview NEXT_PUBLIC_PREVIEW_UNCONFIRMED=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
