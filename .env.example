# Copy to .env.local for local development, and add the same variables in your
# host's dashboard (Vercel → Project → Settings → Environment Variables).

# ── Site ────────────────────────────────────────────────────────────────────
# Your real domain, https and no trailing slash, e.g. https://www.yourdomain.ca.
# Used for canonical URLs, the sitemap and structured data. Leave it empty until
# the domain is live: the site then uses Vercel's address (or localhost) and
# stays out of search engines. A production build for the real domain fails
# unless a lead destination (Airtable or a webhook) and an owner alert are set.
NEXT_PUBLIC_SITE_URL=
# Hosts other than Vercel: production, preview or development. (Vercel sets VERCEL_ENV.)
SITE_ENV=
# Set to false to keep a live domain out of search engines anyway.
SITE_INDEXABLE=
# Preview builds only: true shows claims Kane hasn't confirmed yet, tagged
# "Unconfirmed", so they can be reviewed. Ignored in production.
NEXT_PUBLIC_PREVIEW_UNCONFIRMED=

# Setup steps for everything below: docs/integrations/README.md.
# A lead needs at least one durable destination (Airtable or a webhook) and
# Kane needs at least one alert (email, Quo or ntfy) before the live site deploys.

# ── Airtable CRM (a durable destination) ────────────────────────────────────
# Seller leads go to "Seller Leads" and investor signups to "Buyers" in your
# "Wholesaling CRM" base. Field mapping: src/config/airtable.ts.
# Create a personal access token at https://airtable.com/create/tokens with the
# scope data.records:write, and give it access to the Wholesaling CRM base.
AIRTABLE_TOKEN=
# Your Wholesaling CRM base.
AIRTABLE_BASE_ID=appGQyG43cqRRWYd1
# Optional: the name of an opt-outs table (fields: Address, Name, Phone, Email, Channel, Notes, Date).
AIRTABLE_OPTOUT_TABLE=

# ── Webhooks (recommended: the free Google Sheets backup) ──────────────────
# Every lead, buyer signup and opt-out as JSON ("type" is seller_lead,
# buyer_signup or opt_out). Comma-separate to send to several. The Sheets
# backup URL ends in /exec?secret=YOUR_SECRET (docs/integrations/google-sheets-backup.gs).
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header (Zapier, Make…).
LEAD_WEBHOOK_SECRET=

# ── Email via https://resend.com (owner alerts and seller confirmations) ────
RESEND_API_KEY=
# Where alert emails go. Comma-separate for several. Seller replies go to the first.
LEAD_EMAIL_TO=
# Sender, on a domain you've verified in Resend, e.g. "Kane at Aurora Home Buyers <kane@yourdomain.ca>".
LEAD_EMAIL_FROM=
# Confirmation email to sellers who gave an address (default on). Set to false to turn it off.
SELLER_ACK_EMAIL=

# ── Texts through Quo (dormant until all three are set) ─────────────────────
QUO_API_KEY=
# Your Quo number (any format) or its PN… ID.
QUO_FROM_NUMBER=
# Where lead alerts are texted: your cell. Comma-separate for several.
QUO_NOTIFY_TO=
# Optional. Defaults to https://api.quo.com.
QUO_API_BASE=
# Text sellers who ticked the consent box, 08:00–21:00 Edmonton time (default off). Set to true to turn on.
SELLER_ACK_SMS=

# ── Push to your phone through https://ntfy.sh (free, optional) ─────────────
# A long, random topic, e.g. https://ntfy.sh/aurora-7f3k9q2m…  No personal information is sent.
NTFY_TOPIC_URL=
# Only for a protected topic.
NTFY_TOKEN=

# ── Analytics & search engines (all optional) ───────────────────────────────
# Google Tag Manager container (recommended; manage GA4, Google Ads, Meta Pixel in one place).
NEXT_PUBLIC_GTM_ID=
# Or GA4 directly if you don't use GTM.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code (just the content value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification code.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Microsoft Clarity heatmaps and recordings (free, off by default). Set masking to "Strict" in Clarity,
# and name Clarity in content/legal/privacy.md before you turn it on.
NEXT_PUBLIC_CLARITY_ID=

# ── Cloudflare Turnstile bot check (free, off by default) ───────────────────
# Turn on only if spam gets past the honeypot. Set both: the site key shows the invisible widget,
# the secret checks tokens on the server. Name Turnstile in the privacy policy when it's on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
