# Copy to .env.local for local development, and add the same variables in your
# host's dashboard (Vercel → Project → Settings → Environment Variables).

# ── Site ────────────────────────────────────────────────────────────────────
# Your production URL, no trailing slash. Used for canonical URLs, the sitemap
# and structured data. Overrides `url` in src/config/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# ── Lead delivery (set at least one) ────────────────────────────────────────
# Webhook(s) that receive each lead as JSON. Comma-separate to send to several.
# Works with Zapier/Make "Catch Hook", GoHighLevel inbound webhooks, REsimpli,
# Podio (via Zapier), Google Sheets (via Apps Script), etc.
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=

# Email notifications via https://resend.com (free tier is plenty).
RESEND_API_KEY=
# Where lead emails go. Comma-separate for multiple recipients.
LEAD_EMAIL_TO=
# Sender. Must be on a domain you've verified in Resend, e.g. "Leads <leads@yourdomain.com>".
LEAD_EMAIL_FROM=

# ── Analytics & search engines (all optional) ───────────────────────────────
# Google Tag Manager container (recommended; manage GA4, Google Ads, Meta Pixel in one place).
NEXT_PUBLIC_GTM_ID=
# Or GA4 directly if you don't use GTM.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code (just the content value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification code.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
